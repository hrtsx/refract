{
  "id": "test-gen",
  "version": "0.1.0",
  "entry": "bin/refract-plugin-test-gen",
  "description": "Reads coverage_gap_analyzer output from refract MCP and emits RSpec stubs for untested methods. Demo-grade.",
  "capabilities": {
    "lsp_requests": ["refract.test-gen.suggest"],
    "lsp_notifications": [],
